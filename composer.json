{
    "name": "migears/validator",
    "description": "Lightweight declarative validation — error codes, i18n-ready",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "validation",
        "validator",
        "form",
        "input",
        "i18n",
        "migears"
    ],
    "homepage": "https://github.com/samxxu/migears-validator",
    "authors": [
        {
            "name": "Sam X. Xu",
            "email": "samxxu@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/samxxu/migears-validator/issues",
        "source": "https://github.com/samxxu/migears-validator"
    },
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Validator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Validator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
